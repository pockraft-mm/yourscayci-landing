{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yourscayci-landing",
  "compatibility_date": "2026-09-23",
  "build": {
    "command": "npm run build"
  },
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
